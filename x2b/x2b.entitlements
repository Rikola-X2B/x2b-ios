<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.carplay-driving-task</key>
	<true/>
	<!-- Shared with the X2BWidget extension - lets the two processes exchange the
	     displayed box's URL/cookie/slot state, since a widget extension can't reach
	     into the main app's WKWebsiteDataStore or in-memory CarPlayEntityStore. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.energy.inno.x2b</string>
	</array>
</dict>
</plist>
